# Copy to apps/web/.env.local (gitignored) and restart `bun dev`.

# The Visus API.
#   Local: cd apps/server && bun run dev:phone   → http://localhost:8787
#   Deployed: https://visus-api.<your-subdomain>.workers.dev
NEXT_PUBLIC_API_URL=http://localhost:8787

# 1 = mock data from apps/web/services/mock (no server needed). 0 = the real API above.
NEXT_PUBLIC_USE_MOCK=0

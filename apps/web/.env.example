# Copy to apps/web/.env.local (gitignored) and restart `bun dev`.

# The Visus API.
#   Local: cd apps/server && bun run dev:phone   → http://localhost:8787
#   Deployed: https://visus-api.<your-subdomain>.workers.dev
NEXT_PUBLIC_API_URL=http://localhost:8787

# 1 = mock data from apps/web/services/mock (no server needed). 0 = the real API above.
NEXT_PUBLIC_USE_MOCK=0

# Consult video on mock data only (the real App ID and token come from the server's join route).
# Either an Agora project in testing mode (App ID only):
NEXT_PUBLIC_AGORA_TEST_APP_ID=
# ...or a project with a certificate plus a temporary token made in the Agora console for one channel:
NEXT_PUBLIC_AGORA_TEST_TOKEN=
NEXT_PUBLIC_AGORA_TEST_CHANNEL=
# Never put the App Certificate here: it is a server secret (apps/server/.dev.vars).

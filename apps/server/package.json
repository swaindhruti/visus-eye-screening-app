{
  "name": "@visus/server",
  "type": "module",
  "scripts": {
    "dev": "NODE_EXTRA_CA_CERTS=./aiven-ca.pem wrangler dev",
    "dev:phone": "bun --watch src/local.ts",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "typecheck": "tsc -p .",
    "db:push": "drizzle-kit push",
    "smoke": "bash scripts/smoke.sh"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@visus/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "sarvamai": "^1.1.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261021.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "wrangler": "^4.110.0"
  }
}
